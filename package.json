    "review:names": "node --import ./tests/helpers/offline-imports.mjs tools/playtest/equipment-names.mjs",
    "review:pixels": "node tools/playtest/pixel-style-review.mjs",
    "test:browser:render-finite": "node tests/browser/render-finite.mjs",
    "test:browser:pixel-review": "node tests/browser/pixel-style-review.mjs",
    "balance:ships": "node --import ./tests/helpers/offline-imports.mjs tools/balance/player-ships.mjs current && node --import ./tests/helpers/offline-imports.mjs tools/balance/moving-combat.mjs",
    "test:browser:graveyard": "node tests/browser/graveyard-exploration.mjs",
    "test:browser:asteroid-racing": "node tools/playtest/asteroid-review.mjs && node tools/playtest/race-session.mjs && node tests/browser/asteroid-racing.mjs && node tests/browser/asteroid-race-session.mjs",
    "test:browser:racing": "node tests/browser/graveyard-racing.mjs",
    "test:browser:concourse": "node tests/browser/concourse-ships.mjs",
    "test:browser:locations": "node tests/browser/location-buttons.mjs",
    "test:browser:planets": "node tests/browser/planet-transitions.mjs",
    "test:browser:stations": "node tests/browser/station-transitions.mjs",
    "test:browser:cinematic-handoffs": "node tests/browser/cinematic-handoff.mjs",
    "test:browser:navigation": "node tests/browser/mining-navigation.mjs",
    "test:browser:station-performance": "node tests/browser/station-performance.mjs",
    "review:stations": "node tools/playtest/station-review.mjs",
    "test:browser:station-models": "node tools/playtest/station-review.mjs && node tests/browser/station-models.mjs",
    "test:browser:comms": "node tools/playtest/race-session.mjs && node tests/browser/cockpit-comms.mjs",
    "test:browser:race-boosts": "node tools/playtest/race-session.mjs && node tests/browser/race-boosts.mjs",
    "test:browser:race-contact": "node tools/playtest/race-session.mjs && node tests/browser/race-contact.mjs",
    "test:browser:race-hulls": "node tools/playtest/race-session.mjs && node tests/browser/race-hulls.mjs",
    "balance:racing": "node --import ./tests/helpers/offline-imports.mjs tools/balance/racing-hulls.mjs",
    "test:browser:station-surfaces": "node tools/playtest/station-review.mjs && node tests/browser/station-surfaces.mjs",
    "test:browser:survey": "node tests/browser/tutorial-survey.mjs",
    "test:browser:carrier-hiding": "node tests/browser/carrier-hiding.mjs",
    "review:paint-quality": "node tools/playtest/repaint-review.mjs && node tools/playtest/paint-quality.mjs",
    "review:paint": "node tools/playtest/repaint-review.mjs",
    "test:browser:paint": "node tests/browser/custom-paint.mjs",
    "test:browser:exploration": "node tests/browser/exploration.mjs",
    "test:browser:combat-feedback": "node tests/browser/combat-feedback.mjs",
    "review:discoveries": "node tools/playtest/exploration-review.mjs",
    "test:browser:discovery-review": "node tools/playtest/exploration-review.mjs && node tests/browser/exploration-review.mjs",
    "test:browser:space-pickups": "node tools/playtest/exploration-review.mjs && node tests/browser/space-pickups.mjs",
    "test:browser:cargo-usage": "node tools/playtest/exploration-review.mjs && node tests/browser/cargo-usage.mjs"
