{
  "name": "voidrunner",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/maintenance/run-tests.mjs",
    "test:unit": "node tools/maintenance/run-tests.mjs unit",
    "test:integration": "node tools/maintenance/run-tests.mjs integration",
    "test:performance": "node tools/maintenance/run-tests.mjs performance",
    "test:render": "node --import ./tests/helpers/offline-imports.mjs --test tests/performance/render-work.test.mjs tests/integration/glb-packed-accessors.test.mjs tests/performance/renderer-resources.test.mjs tests/performance/phone-power.test.mjs",
    "test:browser": "node tests/browser/gameplay-smoke.mjs && node tests/browser/player-actions.mjs",
    "build": "node tools/maintenance/package-runtime.mjs",
    "audit:collisions": "node --import ./tests/helpers/offline-imports.mjs tools/assets/audit-ship-collisions.mjs",
    "benchmark:collisions": "node --import ./tests/helpers/offline-imports.mjs tools/assets/benchmark-ship-collisions.mjs",
    "verify:sources": "node tools/maintenance/verify-sources.mjs",
    "test:icons": "node --import ./tests/helpers/offline-imports.mjs tools/playtest/icon-gallery.mjs && node tools/playtest/check-icon-gallery.mjs"
  },
  "version": "0.8.2-a",
  "devDependencies": {
    "playwright": "1.57.0"
  }
}
