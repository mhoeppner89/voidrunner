{
  "name": "voidrunner",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:static": "node scripts/build-static.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:logic": "node --test tests/logic.test.mjs"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@types/three": "^0.179.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
