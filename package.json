{
  "name": "voidrunner",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/maintenance/run-tests.mjs",
    "test:unit": "node tools/maintenance/run-tests.mjs unit",
    "test:integration": "node tools/maintenance/run-tests.mjs integration",
    "test:performance": "node tools/maintenance/run-tests.mjs performance",
    "test:render": "node --import ./tests/helpers/offline-imports.mjs --test tests/performance/render-work.test.mjs tests/integration/glb-packed-accessors.test.mjs tests/performance/renderer-resources.test.mjs tests/performance/phone-power.test.mjs",
    "test:browser": "node tests/browser/gameplay-smoke.mjs && node tests/browser/player-actions.mjs && node tests/browser/offline-startup.mjs",
    "test:browser:tutorial": "node tests/browser/tutorial-departure.mjs && node tests/browser/tutorial-guidance.mjs && node tests/browser/tutorial-campaign.mjs && node tests/browser/vesper-lessons.mjs && node tests/browser/story-menus.mjs && node tests/browser/tutorial-mining.mjs",
    "test:browser:wrecks": "node tests/browser/ship-wrecks.mjs",
    "test:browser:weapons": "node tests/browser/weapon-groups.mjs",
    "test:browser:loot": "node tests/browser/loot-visuals.mjs",
    "test:browser:ship": "node tests/browser/ship-console.mjs",
    "build": "node tools/maintenance/package-runtime.mjs",
    "audit:collisions": "node --import ./tests/helpers/offline-imports.mjs tools/assets/audit-ship-collisions.mjs",
    "benchmark:collisions": "node --import ./tests/helpers/offline-imports.mjs tools/assets/benchmark-ship-collisions.mjs",
    "verify:sources": "node tools/maintenance/verify-sources.mjs",
    "test:icons": "node --import ./tests/helpers/offline-imports.mjs tools/playtest/icon-gallery.mjs && node tools/playtest/check-icon-gallery.mjs",
    "review:names": "node --import ./tests/helpers/offline-imports.mjs tools/playtest/equipment-names.mjs",
    "balance:ships": "node --import ./tests/helpers/offline-imports.mjs tools/balance/player-ships.mjs current && node --import ./tests/helpers/offline-imports.mjs tools/balance/moving-combat.mjs",
    "test:browser:graveyard": "node tests/browser/graveyard-exploration.mjs",
    "test:browser:asteroid-racing": "node tools/playtest/asteroid-review.mjs && node tools/playtest/race-session.mjs && node tests/browser/asteroid-racing.mjs && node tests/browser/asteroid-race-session.mjs",
    "test:browser:racing": "node tests/browser/graveyard-racing.mjs",
    "test:browser:comms": "node tools/playtest/race-session.mjs && node tests/browser/cockpit-comms.mjs",
    "test:browser:race-boosts": "node tools/playtest/race-session.mjs && node tests/browser/race-boosts.mjs",
    "test:browser:race-contact": "node tools/playtest/race-session.mjs && node tests/browser/race-contact.mjs",
    "test:browser:race-hulls": "node tools/playtest/race-session.mjs && node tests/browser/race-hulls.mjs",
    "balance:racing": "node --import ./tests/helpers/offline-imports.mjs tools/balance/racing-hulls.mjs"
  },
  "version": "0.8.2-a",
  "devDependencies": {
    "playwright": "1.57.0"
  }
}
